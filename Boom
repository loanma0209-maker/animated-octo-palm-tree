TargetTab:CreateButton({
    Name = "Bring Target",
    Callback = function()
        if not State.SelectedTarget then
            Notify("Error", "Select target first!", 3)
            return
        end
        
        local targetHRP = GetHRP(State.SelectedTarget)
        local myHRP = GetHRP()
        
        if targetHRP and myHRP then
            pcall(function()
                if SetNetworkOwner then
                    SetNetworkOwner:FireServer(targetHRP, LocalPlayer)
                end
                targetHRP.CFrame = myHRP.CFrame + Vector3.new(0, 5, 0)
            end)
        end
    end
})


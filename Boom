-- Utility Functions
local function Notify(title, content, duration)
    if not State.NotificationsEnabled then return end
    duration = duration or 3
    -- Obsidian notification or fallback
    pcall(function()
        local lib = loadstring(game:HttpGet("https://raw.githubusercontent.com/deeeity/obsidian/main/obsidian.lua", true))()
        lib:Notify(title, content, duration)
    end)
end

local function GetCharacter(player)
    player = player or LocalPlayer
    return player.Character
end

local function GetHumanoid(player)
    local char = GetCharacter(player)
    if char then
        return char:FindFirstChildOfClass("Humanoid")
    end
end

local function GetHRP(player)
    local char = GetCharacter(player)
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
end

local function GetPlayerList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(list, plr.DisplayName .. " (@" .. plr.Name .. ")")
        end
    end
    return list
end

local function ResolvePlayerFromString(str)
    if not str then return nil end
    local username = str:match("%(@ ?(.+)%)") or str
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == username or plr.DisplayName == str then
            return plr
        end
    end
    return nil
end

-- Anti-Grab Systems
local AntiGrabConnections = {}
local GucciConnections = {}

local function SetupAntiGrab()
    if not State.AntiGrabEnabled then return end
    
    local char = GetCharacter()
    if not char then return end
    
    local hrp = GetHRP()
    local hum = GetHumanoid()
    if not hrp or not hum then return end
    
    -- Core anti-grab: Monitor SeatPart changes
    local seatConn = hum:GetPropertyChangedSignal("SeatPart"):Connect(function()
        if hum.SeatPart then
            local seat = hum.SeatPart
            local blobman = seat:FindFirstAncestor("CreatureBlobman")
            if blobman then
                -- Immediate release
                task.spawn(function()
                    task.wait(0.05)
                    pcall(function()
                        hum.Sit = false
                        hrp.Anchored = false
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                end)
            end
        end
    end)
    
    table.insert(AntiGrabConnections, seatConn)
    
    -- Monitor being held
    local heldConn = hrp.ChildAdded:Connect(function(child)
        if child.Name == "BeingHeld" or child.Name == "FreezeJoint" then
            task.delay(0.03, function()
                pcall(function()
                    child:Destroy()
                    hrp.Anchored = false
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end)
            end)
        end
    end)
    
    table.insert(AntiGrabConnections, heldConn)
end

local function SetupAntiGrabV2()
    -- Advanced anti-grab with CFrame manipulation
    if not State.AntiGrabV2Enabled then return end
    
    local char = GetCharacter()
    if not char then return end
    
    local hrp = GetHRP()
    if not hrp then return end
    
    local conn = RunService.Heartbeat:Connect(function()
        if hrp.Anchored then
            hrp.Anchored = false
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
        
        -- Check for grab attachments
        for _, child in ipairs(hrp:GetChildren()) do
            if child:IsA("Attachment") and (child.Name:match("Grab") or child.Name:match("Weld")) then
                child:Destroy()
            end
        end
    end)
    
    table.insert(AntiGrabConnections, conn)
end


TargetTab:CreateButton({
    Name = "Refresh Player List",
    Callback = function()
        PlayerDropdown:Set(GetPlayerList())
    end
})

TargetTab:CreateSection("Kick Methods")

TargetTab:CreateButton({
    Name = "Blobman Kick (Single)",
    Callback = function()
        if not State.SelectedTarget then
            Notify("Error", "Select target first!", 3)
            return
        end
        BlobmanKick(State.SelectedTarget)
        Notify("Target", "Blobman Kick executed", 2)
    end
})

TargetTab:CreateToggle({
    Name = "Blobman Kick All",
    Default = false,
    Callback = function(value)
        State.BlobmanKickAll = value
        if value then
            task.spawn(function()
                while State.BlobmanKickAll do
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer then
                            BlobmanKick(plr)
                        end
                    end
                    task.wait(0.5)
                end
            end)
        end
    end
})

TargetTab:CreateButton({
    Name = "Ownership Kick",
    Callback = function()
        if not State.SelectedTarget then
            Notify("Error", "Select target first!", 3)
            return
        end
        OwnershipKick(State.SelectedTarget)
        Notify("Target", "Ownership Kick executed", 2)
    end
})

TargetTab:CreateToggle({
    Name = "Ownership Kick Loop",
    Default = false,
    Callback = function(value)
        State.OwnershipKickEnabled = value
        if value and State.SelectedTarget then
            task.spawn(function()
                while State.OwnershipKickEnabled and State.SelectedTarget do
                    OwnershipKick(State.SelectedTarget)
                    task.wait(0.1)
                end
            end)
        end
    end
})


-- Kick Functions
local function BlobmanKick(target)
    if not target then return end
    
    local char = GetCharacter(target)
    if not char then return end
    
    local hrp = GetHRP(target)
    if not hrp then return end
    
    -- Spawn blobman and kick
    pcall(function()
        local blobman = Workspace:FindFirstChild("CreatureBlobman", true)
        if blobman then
            local seat = blobman:FindFirstChildOfClass("VehicleSeat")
            if seat then
                -- Force target into blobman and eject
                local targetHum = GetHumanoid(target)
                if targetHum then
                    -- Network ownership manipulation
                    if SetNetworkOwner then
                        for i = 1, 5 do
                            SetNetworkOwner:FireServer(hrp, LocalPlayer)
                            task.wait(0.05)
                        end
                    end
                    
                    -- Apply velocity
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 500, 0)
                    hrp.CFrame = hrp.CFrame + Vector3.new(0, 100, 0)
                end
            end
        end
    end)
end

local function OwnershipKick(target)
    if not target then return end
    
    local char = GetCharacter(target)
    if not char then return end
    
    local hrp = GetHRP(target)
    if not hrp then return end
    
    -- Spam network ownership to kick
    pcall(function()
        if SetNetworkOwner then
            for i = 1, 20 do
                SetNetworkOwner:FireServer(hrp, LocalPlayer)
                task.wait(0.01)
            end
        end
        
        -- Apply extreme force
        hrp.AssemblyLinearVelocity = Vector3.new(0, 1000, 0)
        hrp.CFrame = CFrame.new(0, 10000, 0)
    end)
end

local function LoopKill(target)
    if not target then return end
    
    task.spawn(function()
        while State.LoopKillEnabled and target and target.Character do
            pcall(function()
                local hrp = GetHRP(target)
                if hrp then
                    -- Kill via position manipulation
                    hrp.CFrame = CFrame.new(0, -500, 0)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, -1000, 0)
                end
            end)
            task.wait(0.1)
        end
    end)
end

local function KillGrab(target)
    if not target then return end
    
    pcall(function()
        local hrp = GetHRP(target)
        if hrp and DestroyGrabLine then
            -- Create grab line then destroy to kill
            if CreateGrabLine then
                CreateGrabLine:FireServer(hrp)
            end
            task.wait(0.05)
            DestroyGrabLine:FireServer()
        end
    end)
end


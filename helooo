local function initialize()
    notify("EBOLA V2", "Script loaded successfully")
    
    -- Setup character connections
    LocalPlayer.CharacterAdded:Connect(function(char)
        -- Re-apply enabled features
        if Config.AntiRagdoll then
            enableAntiRagdoll()
        end
        if Config.AntiVoid then
            enableAntiVoid()
        end
    end)
    
    -- Main update loop
    RunService.Heartbeat:Connect(function()
        -- Update ESP colors
        if Config.RainbowPlayerESP then
            updateESP()
        end
        
        -- Update PCLD colors
        if Config.pcldRainbow then
            updatePCLDColors()
        end
        
        -- Update sparklers
        if #activeSparklers > 0 then
            updateSparklers()
        end
    end)
    
    -- Player added for ESP
    Players.PlayerAdded:Connect(function(player)
        if Config.EnablePlayerESP then
            createESP(player)
        end
        if Config.JoinNotifications then
            notify("Join", player.Name .. " joined the game")
        end
    end)
    
    -- Player removing
    Players.PlayerRemoving:Connect(function(player)
        if espObjects[player] then
            removeAllESP()
        end
        if Config.LeaveNotifications then
            notify("Leave", player.Name .. " left the game")
        end
    end)
    
    -- Initial ESP setup
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and Config.EnablePlayerESP then
            createESP(player)
        end
    end
end


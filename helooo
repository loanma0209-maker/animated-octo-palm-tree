local function kickPlayer(player, method)
    if not player or player == LocalPlayer then return end
    if not player.Character then return end
    
    local char = player.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    notify("Kick", "Kicking " .. player.Name .. " using " .. (method or "default"))
    
    -- Method 1: Network Ownership Fling
    if method == "Ownership" or method == nil then
        -- Claim ownership
        setNetworkOwner(hrp)
        
        -- Apply massive velocity
        for i = 1, 10 do
            pcall(function()
                hrp.Velocity = Vector3.new(
                    math.random(-5000, 5000),
                    5000,
                    math.random(-5000, 5000)
                )
                hrp.AssemblyLinearVelocity = Vector3.new(
                    math.random(-5000, 5000),
                    5000,
                    math.random(-5000, 5000)
                )
                hrp.AssemblyAngularVelocity = Vector3.new(
                    math.random(-1000, 1000),
                    math.random(-1000, 1000),
                    math.random(-1000, 1000)
                )
            end)
            task.wait(0.05)
        end
        
        -- Create align position to fling
        local alignPos = Instance.new("AlignPosition")
        alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
        alignPos.MaxForce = math.huge
        alignPos.MaxVelocity = math.huge
        alignPos.Responsiveness = 200
        
        local attachment = Instance.new("Attachment", hrp)
        alignPos.Attachment0 = attachment
        alignPos.Parent = hrp
        
        -- Move to void
        alignPos.Position = hrp.Position + Vector3.new(0, 1000, 0)
        
        task.delay(1, function()
            pcall(function()
                alignPos:Destroy()
                attachment:Destroy()
            end)
        end)
    end
    
    -- Method 2: Blobman Kick (if applicable)
    if method == "Blobman" then
        local blobman = Workspace:FindFirstChild("CreatureBlobman", true)
        if blobman then
            -- Sit on blobman and kick
            local seat = blobman:FindFirstChildOfClass("VehicleSeat")
            if seat then
                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    seat:Sit(hum)
                    task.wait(0.5)
                    -- Now kick the target
                    kickPlayer(player, "Ownership")
                end
            end
        end
    end
end

local function kickAll()
    notify("Kick All", "Initiating mass kick...")
    for _, player in ipairs(getAllPlayers()) do
        task.spawn(function()
            kickPlayer(player, "Ownership")
        end)
        task.wait(0.1)
    end
end


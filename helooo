local shapeOffsets = {
    Sphere = function(t, config)
        local angle = t * math.pi * 2
        return Vector3.new(
            math.cos(angle) * config.Radius,
            math.sin(t * 5) * config.Height,
            math.sin(angle) * config.Radius
        )
    end,
    Box = function(t, config)
        local x = math.cos(t * math.pi * 2) * config.Radius
        local z = math.sin(t * math.pi * 2) * config.Radius
        return Vector3.new(x, math.sin(t * 10) * config.Height, z)
    end,
    Cylinder = function(t, config)
        local angle = t * math.pi * 2
        return Vector3.new(
            math.cos(angle) * config.Radius,
            t * config.Height * 2 - config.Height,
            math.sin(angle) * config.Radius
        )
    end,
    Heart = function(t, config)
        local angle = t * math.pi * 2
        local x = 16 * math.sin(angle)^3
        local y = 13 * math.cos(angle) - 5 * math.cos(2*angle) - 2 * math.cos(3*angle) - math.cos(4*angle)
        return Vector3.new(x * config.Radius/16, y * config.Height/16, 0)
    end,
    Star = function(t, config)
        local angle = t * math.pi * 2
        local r = config.Radius * (1 + 0.5 * math.sin(5 * angle))
        return Vector3.new(
            math.cos(angle) * r,
            math.sin(t * 10) * config.Height,
            math.sin(angle) * r
        )
    end,
    Planet = function(t, config)
        local angle = t * math.pi * 2
        local tilt = math.rad(23.5)
        local x = math.cos(angle) * config.Radius
        local z = math.sin(angle) * config.Radius
        local y = math.sin(t * 5) * config.Height
        return Vector3.new(x, y * math.cos(tilt) - z * math.sin(tilt), z)
    end
}

local function setupSparkler(obj)
    if not obj then return end
    
    local primaryPart = obj:FindFirstChildOfClass("BasePart") or obj.PrimaryPart
    if not primaryPart then return end
    
    local config = {
        Shape = Config.CurrentShape,
        Speed = Config.SparklerSpeed,
        Height = Config.SparklerHeight,
        Radius = Config.SparklerRadius
    }
    
    local bp = Instance.new("BodyPosition")
    bp.Name = "SparklerBP"
    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bp.P = 10000
    bp.D = 1000
    bp.Parent = primaryPart
    
    local bg = Instance.new("BodyGyro")
    bg.Name = "SparklerBG"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 10000
    bg.Parent = primaryPart
    
    table.insert(activeSparklers, {
        obj = obj,
        bp = bp,
        bg = bg,
        startTime = tick()
    })
end

local function updateSparklers()
    for i, sparkler in ipairs(activeSparklers) do
        if not sparkler.obj.Parent then
            if sparkler.bp then sparkler.bp:Destroy() end
            if sparkler.bg then sparkler.bg:Destroy() end
            table.remove(activeSparklers, i)
            continue
        end
        
        local offsetFunc = shapeOffsets[Config.CurrentShape] or shapeOffsets.Sphere
        local t = (tick() - sparkler.startTime) * Config.SparklerSpeed
        
        local offset = offsetFunc(t, {
            Radius = Config.SparklerRadius,
            Height = Config.SparklerHeight,
            Speed = Config.SparklerSpeed
        })
        
        if sparkler.bp then
            sparkler.bp.Position = LocalPlayer.Character and 
                LocalPlayer.Character:GetPivot().Position + offset or 
                Vector3.zero
        end
    end
end


local function spawnBlobman()
    local SpawnToyRF = ReplicatedStorage:WaitForChild("SpawnToyRemoteFunction", 5)
    if not SpawnToyRF then
        notify("Error", "SpawnToyRemoteFunction not found")
        return
    end
    
    local success = pcall(function()
        SpawnToyRF:InvokeServer("CreatureBlobman")
    end)
    
    if success then
        notify("Blobman", "Spawned blobman successfully")
    else
        notify("Error", "Failed to spawn blobman")
    end
end

local function sitOnBlobman()
    local char = LocalPlayer.Character
    if not char then return end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    -- Find blobman
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "CreatureBlobman" then
            local seat = obj:FindFirstChildOfClass("VehicleSeat")
            if seat and not seat.Occupant then
                seat:Sit(hum)
                notify("Blobman", "Sat on blobman")
                return true
            end
        end
    end
    
    notify("Error", "No available blobman found")
    return false
end

local function blobmanKick(player)
    if not player then
        notify("Error", "Select a target first")
        return
    end
    
    -- Spawn blobman if needed
    spawnBlobman()
    task.wait(0.5)
    
    -- Sit on blobman
    if sitOnBlobman() then
        task.wait(0.3)
        -- Grab and kick the target
        local char = player.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                createGrabLine(hrp)
                task.wait(0.5)
                kickPlayer(player, "Ownership")
            end
        end
    end
end

local function blobmanKickAll()
    notify("Blobman", "Kicking all players with blobman...")
    for _, player in ipairs(getAllPlayers()) do
        task.spawn(function()
            blobmanKick(player)
        end)
        task.wait(1) -- Delay between each to allow blobman spawning
    end
end


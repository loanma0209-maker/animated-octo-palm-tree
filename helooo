local GrabEvents = ReplicatedStorage:WaitForChild("GrabEvents", 5)
local SetNetworkOwner = GrabEvents and GrabEvents:FindFirstChild("SetNetworkOwner")
local DestroyGrabLine = GrabEvents and GrabEvents:FindFirstChild("DestroyGrabLine")
local CreateGrabLine = GrabEvents and GrabEvents:FindFirstChild("CreateGrabLine")
local EndGrabEarly = GrabEvents and GrabEvents:FindFirstChild("EndGrabEarly")

local function setNetworkOwner(part, player)
    if not part or not SetNetworkOwner then return false end
    local success = pcall(function()
        SetNetworkOwner:FireServer(part, player or LocalPlayer)
    end)
    return success
end

local function destroyGrabLine()
    if DestroyGrabLine then
        pcall(function()
            DestroyGrabLine:FireServer()
        end)
    end
end

local function createGrabLine(targetPart)
    if not targetPart or not CreateGrabLine then return false end
    local success = pcall(function()
        CreateGrabLine:FireServer(targetPart)
    end)
    return success
end


local function startLoopKill()
    if Config.LoopKillEnabled then return end
    Config.LoopKillEnabled = true
    
    local thread = task.spawn(function()
        while Config.LoopKillEnabled do
            local target = Config.selectedKickPlayer and Players:FindFirstChild(Config.selectedKickPlayer)
            if target and target.Character then
                kickPlayer(target, "Ownership")
            end
            task.wait(Config.LoopDelay or 1)
        end
    end)
    
    table.insert(loopThreads, thread)
    notify("Loop Kill", "Started")
end

local function stopLoopKill()
    Config.LoopKillEnabled = false
    notify("Loop Kill", "Stopped")
end


local Commands = {
    kick = function(args)
        local targetName = args[1]
        if not targetName then
            notify("Error", "Usage: kick <player_name>")
            return
        end
        
        local target = Players:FindFirstChild(targetName)
        if target then
            kickPlayer(target, "Ownership")
        else
            notify("Error", "Player not found: " .. targetName)
        end
    end,
    
    kickall = function()
        kickAll()
    end,
    
    blobkick = function(args)
        local targetName = args[1]
        if not targetName then
            notify("Error", "Usage: blobkick <player_name>")
            return
        end
        
        local target = Players:FindFirstChild(targetName)
        if target then
            blobmanKick(target)
        else
            notify("Error", "Player not found: " .. targetName)
        end
    end,
    
    blobkickall = function()
        blobmanKickAll()
    end,
    
    fly = function()
        if Config.FlightEnabled then
            disableFlight()
        else
            enableFlight()
        end
    end,
    
    noclip = function()
        Config.Noclip = not Config.Noclip
        notify("Noclip", Config.Noclip and "Enabled" or "Disabled")
    end,
    
    esp = function()
        Config.EnablePlayerESP = not Config.EnablePlayerESP
        if Config.EnablePlayerESP then
            for _, player in ipairs(Players:GetPlayers()) do
                createESP(player)
            end
        else
            removeAllESP()
        end
        notify("ESP", Config.EnablePlayerESP and "Enabled" or "Disabled")
    end,
    
    antigrab = function()
        if Config.AntiGrab then
            disableAntiGrab()
        else
            enableAntiGrab()
        end
    end,
    
    antiragdoll = function()
        Config.AntiRagdoll = not Config.AntiRagdoll
        if Config.AntiRagdoll then
            enableAntiRagdoll()
        end
        notify("Anti Ragdoll", Config.AntiRagdoll and "Enabled" or "Disabled")
    end,
    
    rejoin = function()
        local TeleportService = game:GetService("TeleportService")
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end,
    
    reset = function()
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.Health = 0
            end
        end
    end
}

-- Chat command handler
LocalPlayer.Chatted:Connect(function(message)
    if message:sub(1, 1) == "!" then
        local args = {}
        for arg in message:sub(2):gmatch("%S+") do
            table.insert(args, arg)
        end
        
        local cmd = table.remove(args, 1)
        if Commands[cmd] then
            Commands[cmd](args)
        end
    end
end)


local function createPCLDBox(part)
    if not part or not Config.pcldEnabled then return end
    
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "PCLD_Box"
    box.Adornee = part
    box.Size = part.Size + Vector3.new(0.1, 0.1, 0.1)
    box.Color3 = Config.pcldColor
    box.Transparency = 0.5
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Parent = game.CoreGui
    
    table.insert(pcldBoxes, box)
    
    local conn = part.AncestryChanged:Connect(function()
        if not part:IsDescendantOf(Workspace) then
            box:Destroy()
        end
    end)
    
    table.insert(pcldConnections, conn)
end

local function scanPCLD()
    if not Config.pcldEnabled then return end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == "TruePositionPart" then
            createPCLDBox(obj)
        end
    end
end

local function removeAllPCLD()
    for _, box in ipairs(pcldBoxes) do
        if box then box:Destroy() end
    end
    pcldBoxes = {}
    
    for _, conn in ipairs(pcldConnections) do
        if conn then conn:Disconnect() end
    end
    pcldConnections = {}
end

local function updatePCLDColors()
    if Config.pcldRainbow then
        local hue = tick() % 5 / 5
        Config.pcldColor = Color3.fromHSV(hue, 1, 1)
    end
    
    for _, box in ipairs(pcldBoxes) do
        if box then
            box.Color3 = Config.pcldColor
        end
    end
end


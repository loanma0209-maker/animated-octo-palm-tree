local function getSpawnedToys()
    local toys = {}
    local spawnFolder = Workspace:FindFirstChild("SpawnedInToys")
    if spawnFolder then
        for _, obj in ipairs(spawnFolder:GetChildren()) do
            table.insert(toys, obj)
        end
    end
    return toys
end

local function getAllBombs()
    local bombs = {}
    local spawnFolder = Workspace:FindFirstChild("SpawnedInToys")
    if spawnFolder then
        for _, obj in ipairs(spawnFolder:GetChildren()) do
            if obj.Name:find("Bomb") or obj.Name:find("Missile") then
                table.insert(bombs, obj)
            end
        end
    end
    return bombs
end

local function explodeBomb(bomb)
    if not bomb then return end
    
    local explosionMaker = bomb:FindFirstChild("ExplosionMaker")
    if explosionMaker then
        -- Trigger explosion
        local particlePresets = explosionMaker:FindFirstChild("ParticlePresets")
        if particlePresets then
            for _, emitter in ipairs(particlePresets:GetChildren()) do
                if emitter:IsA("ParticleEmitter") then
                    emitter:Emit(Config.ExplosionAmount)
                end
            end
        end
    end
    
    -- Also try to use remote if available
    local bombEvents = ReplicatedStorage:FindFirstChild("BombEvents")
    if bombEvents then
        local explodeRemote = bombEvents:FindFirstChild("ExplodeBomb")
        if explodeRemote then
            explodeRemote:FireServer(bomb)
        end
    end
end

local function deleteAllBombs()
    for _, bomb in ipairs(getAllBombs()) do
        local destroyToy = ReplicatedStorage:FindFirstChild("DestroyToy")
        if destroyToy then
            destroyToy:FireServer(bomb)
        else
            bomb:Destroy()
        end
    end
    notify("Explosion", "Deleted all bombs")
end

